// bbport: camera motion vectors from depth and the current/previous camera (Bloodborne's scene
// constants, see docs/upscaler.md). DEBUG_OVERLAY blends them as colors into the frame.
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D depth_tex; // D32, depth 0..1 (D3D projection)
#ifdef DEBUG_OVERLAY
layout(binding = 1, rgba8) uniform image2D color_img;
layout(binding = 2, std430) readonly buffer PrevFrame { uint prev_frame[]; };
layout(binding = 3, std430) writeonly buffer NextFrame { uint next_frame[]; };
#else
layout(binding = 1, rg16f) uniform writeonly image2D motion_img; // pixels, previous - current
// Object motion from the G-buffer: rg pixels, b = valid, a = written depth.
layout(binding = 2) uniform texture2D object_tex;
#endif

layout(push_constant) uniform Constants {
    vec4 reproject[3]; // previous view * inverse current view, XY columns / current proj.xy
    vec4 proj;         // current: x scale, y scale, z scale, z offset
    vec4 prev_proj;    // previous: x scale, y scale, z scale, z offset
    vec2 size;         // pixels
    vec2 jitter;       // current viewport shift in render pixels (x right, y down)
    vec2 previous_jitter;
    uint mode;         // motion: 1 = object motion vectors available; debug: 0 motion, 1 raw
                       // depth, 2 view z / 50, 3 reprojected previous frame, 4 |difference|
    float object_depth_tolerance; // fraction of current projection depth distance (default 0.01)
    float inv_depth_offset; // CPU-computed 1 / proj.w; avoids a division for each pixel
};

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(size.x) || pixel.y >= int(size.y)) {
        return;
    }
    const float depth = texelFetch(depth_tex, pixel, 0).r;
#ifndef DEBUG_OVERLAY
    if (mode == 1) {
        const vec4 object_motion = texelFetch(object_tex, pixel, 0);
        // Object motion has already reprojected this pixel using its skinned vertex
        // positions. Prefer that motion, but only while its depth still matches
        // the final scene: ordinary draws can cover an earlier instrumented draw.
        // Reject magnitudes that RG16F cannot represent safely (including NaNs/Inf).
        const float depth_threshold =
            max(2e-7, (proj.z - depth) * object_depth_tolerance);
        if (object_motion.b > 0.99 &&
            abs(object_motion.a - depth) < depth_threshold &&
            all(lessThan(abs(object_motion.rg), vec2(32768.0)))) {
            imageStore(motion_img, pixel, vec4(object_motion.rg, 0.0, 0.0));
            return;
        }
    }
    // Avoid an expensive camera reprojection altogether for accepted object pixels.
#endif
    const vec2 uv = (vec2(pixel) + 0.5) / size;
    // Depth was rasterised through a shifted viewport. Reconstruct its unjittered
    // position, and keep jitter out of FSR's motion vectors (as for the object vectors).
    const vec2 scene_uv = uv - jitter / size;
    const vec2 ndc = vec2(scene_uv.x * 2.0 - 1.0, 1.0 - scene_uv.y * 2.0);

    // Depth = proj.z + proj.w / z. Previous-view perspective division cancels
    // the current z: transform (ndc.xy, 1, 1/z) with rows normalized once on
    // the CPU instead of reconstructing a 3D view position at every pixel.
    // Sky uses w=0, retaining rotation without camera translation.
    const bool sky = depth >= 1.0;
    const float inv_z = sky ? 0.0 : min(depth - proj.z, -1e-8) * inv_depth_offset;
    const vec4 view_over_z = vec4(ndc, 1.0, inv_z);
    const vec3 prev_over_z =
        vec3(dot(reproject[0], view_over_z), dot(reproject[1], view_over_z),
             dot(reproject[2], view_over_z));
    // A positive previous-view z is required; express the original 1e-4
    // distance cutoff in the normalized space (z=1 for sky).
    const float near_limit = 1e-4 * (sky ? 1.0 : inv_z);
    const vec2 prev_ndc =
        (prev_over_z.xy * prev_proj.xy) / max(prev_over_z.z, near_limit);
    const vec2 prev_uv = vec2(prev_ndc.x * 0.5 + 0.5, 0.5 - prev_ndc.y * 0.5);
    const vec2 reprojected_motion = (prev_uv - scene_uv) * size;
    // When the current pixel was behind the previous camera, no valid history
    // location exists. The denominator clamp alone can produce velocities that
    // overflow our RG16F motion texture near the old camera plane. Use a finite
    // off-screen motion instead, asking the temporal upscaler to reject history.
    // Also reject NaNs/infinities and magnitudes that cannot be represented
    // robustly in a signed 16-bit floating-point motion channel.
    const bool valid_reprojection = prev_over_z.z > near_limit &&
        all(lessThan(abs(reprojected_motion), vec2(32768.0)));
    const vec2 motion = valid_reprojection ? reprojected_motion : -2.0 * size;

#ifdef DEBUG_OVERLAY
    const vec4 current = imageLoad(color_img, pixel);
    next_frame[pixel.y * int(size.x) + pixel.x] = packUnorm4x8(current);
    if (mode == 3 || mode == 4) {
        const ivec2 prev_pixel = ivec2(floor(uv * size + motion + previous_jitter - jitter));
        vec4 prev = vec4(0.0, 0.0, 0.0, 1.0);
        if (all(greaterThanEqual(prev_pixel, ivec2(0))) && all(lessThan(prev_pixel, ivec2(size)))) {
            prev = unpackUnorm4x8(prev_frame[prev_pixel.y * int(size.x) + prev_pixel.x]);
        }
        const vec3 out_color = mode == 3 ? prev.rgb : abs(prev.rgb - current.rgb) * 4.0;
        imageStore(color_img, pixel, vec4(out_color, current.a));
        return;
    }
    if (mode == 1) {
        // Raw depth visualization
        imageStore(color_img, pixel, vec4(fract(depth * 4.0), depth, depth < 0.0 ? 1.0 : 0.0, 1.0));
        return;
    } else if (mode == 2) {
        // View-space depth visualization (z / 50)
        const float z = sky ? 1.0 : 1.0 / inv_z;
        const float v = z / 50.0;
        imageStore(color_img, pixel, vec4(fract(v * 4.0), v, v < 0.0 ? 1.0 : 0.0, 1.0));
        return;
    }
    // Mode 0: motion vectors blended with current frame
    // Red/green: horizontal/vertical motion (grey = none), 64 pixels to full scale.
    // Sky = dark blue, motion magnitude shown by color deviation from grey
    const vec3 mv_color = sky ? vec3(0.0, 0.0, 0.3) : vec3(0.5) + vec3(motion / 128.0, 0.0);
    imageStore(color_img, pixel, vec4(mix(current.rgb, mv_color, 0.75), current.a));
#else
    imageStore(motion_img, pixel, vec4(motion, 0.0, 0.0));
#endif
}
